  <syntaxId>xwiki/2.1</syntaxId>
  <hidden>false</hidden>
  <enforceRequiredRights>true</enforceRequiredRights>
  <content>{{translation key="rfc.home.description"/}}

{{velocity}}
#if ($services.security.authorization.hasAccess('edit', $services.model.resolveSpace('RFC')))
  #set ($createURL = $doc.getURL('create', 'templateprovider=RFC.Code.RFCTemplateProvider'))
  {{html clean="false"}}
  &lt;p&gt;
    &lt;a href="$escapetool.xml($createURL)" class="btn btn-primary"&gt;
      $services.icon.renderHTML('add') $escapetool.xml($services.localization.render('rfc.home.create'))
    &lt;/a&gt;
  &lt;/p&gt;
  {{/html}}
#end
#if ($hasAdmin)
  ## Pages created with version 1.x of the application still hold an object of the old class.
  #set ($legacyPagesQuery = $services.query.xwql("from doc.object('RFCCode.RFCClass') as rfc where doc.space &lt;&gt; 'RFCCode'"))
  #if (!$legacyPagesQuery.setLimit(1).execute().isEmpty())
    {{warning}}
      {{translation key="rfc.home.legacyDataWarning"/}} [[{{translation key="rfc.home.legacyDataLink"/}}&gt;&gt;RFC.Code.RFCMigration]]
    {{/warning}}
  #end
#end
## Filter presets: a request parameter selects the filters applied to the listing below.
#set ($presets = ['all', 'draft', 'proposed', 'final'])
#if ($xcontext.userReference)
  #set ($discard = $presets.add('mine'))
#end
#set ($selectedPreset = "$!request.rfcFilter")
#if (!$presets.contains($selectedPreset))
  #set ($selectedPreset = 'all')
#end
#if ($selectedPreset == 'mine')
  #set ($listFilters = "doc.creator=$escapetool.url($services.model.serialize($xcontext.userReference, 'local'))")
#elseif ($selectedPreset != 'all')
  #set ($listFilters = "status=$selectedPreset")
#else
  #set ($listFilters = '')
#end
{{html clean="false"}}
&lt;div class="rfc-filters"&gt;
  &lt;span class="rfc-filters-label"&gt;$escapetool.xml($services.localization.render('rfc.home.filters.label'))&lt;/span&gt;
  &lt;div class="btn-group" role="group"&gt;
    #foreach ($preset in $presets)
      #set ($presetClass = 'btn btn-default')
      #if ($preset == $selectedPreset)
        #set ($presetClass = "$presetClass active")
      #end
      &lt;a class="$presetClass" href="$escapetool.xml($doc.getURL('view', "rfcFilter=$preset"))"&gt;$escapetool.xml($services.localization.render("rfc.home.filters.$preset"))&lt;/a&gt;
    #end
  &lt;/div&gt;
&lt;/div&gt;
{{/html}}

